{
  "schema_version": 1,
  "steps": [
    "build_cohort",
    "fit_candidates",
    "select_ensemble",
    "deploy_ensemble"
  ],
  "inputs": {
    "aggregate_h5ad": "../../data/lincs/lincs_merge_chemical_filter_select_align_aggregate.h5ad",
    "compound_info": "../../data/lincs/compoundinfo_beta.txt",
    "tox21_smiles": "../../data/tox21/tox21_smiles.csv",
    "pretrained_gnn_root": "../../data/models/pretrained_gnn",
    "gnn_pretrained_variant": "supervised_contextpred",
    "chemberta_model": "../../data/models/chemberta/DeepChem_ChemBERTa-100M-MLM",
    "chemprop_python": "/data/kyungan/miniconda3/envs/BioTox_chemprop/bin/python"
  },
  "outputs": {
    "cohort_dir": "../../data/generated/molecular_prediction_and_ensemble/cohort",
    "stage1_dir": "../../data/generated/molecular_prediction_and_ensemble/candidates",
    "ensemble_selection_dir": "../../data/generated/molecular_prediction_and_ensemble/topk_selection",
    "deployment_dir": "../../data/generated/molecular_prediction_and_ensemble/deployed_k4"
  },
  "cohort": {
    "cells": ["HA1E", "HEPG2", "HT29", "MCF7"],
    "exposure_time_hours": 6,
    "dose_window_um": [8.0, 12.0],
    "cohort_train_fraction": 0.7,
    "cohort_valid_fraction": 0.3,
    "development_train_fraction": 0.6,
    "development_valid_fraction": 0.2,
    "development_test_fraction": 0.2
  },
  "candidate_training": {
    "tasks": [
      "NR-AR",
      "NR-AR-LBD",
      "NR-AhR",
      "NR-Aromatase",
      "NR-ER",
      "NR-ER-LBD",
      "NR-PPAR-gamma",
      "SR-ARE",
      "SR-ATAD5",
      "SR-HSE",
      "SR-MMP",
      "SR-p53"
    ],
    "candidates": [
      "MACCS_LR",
      "MACCS_XGB",
      "Morgan_LR",
      "Morgan_XGB",
      "RDKit_LR",
      "RDKit_XGB",
      "GCN_Pretrained",
      "GAT_Pretrained",
      "GIN_Pretrained",
      "GraphSAGE_Pretrained",
      "ChemBERTa_Pretrained",
      "Chemprop"
    ],
    "seed": 1,
    "gpu_ids": [0, 1],
    "n_jobs": 1,
    "cache_source_dir": null,
    "model_settings": {
      "classical": {
        "logreg_c_grid": [0.001, 0.01, 0.1, 1.0, 10.0, 100.0],
        "logreg_max_iter": 2000,
        "xgb_max_depth_grid": [3, 4, 6],
        "xgb_learning_rate_grid": [0.05, 0.1],
        "xgb_default_max_depth": 4,
        "xgb_default_learning_rate": 0.05,
        "xgb_n_estimators": 300,
        "xgb_early_stopping_rounds": 20,
        "xgb_subsample": 0.8,
        "xgb_colsample_bytree": 0.8
      },
      "gnn": {
        "batch_size": 32,
        "hidden_dim": 300,
        "n_layers": 5,
        "dropout": 0.5,
        "graph_pooling": "mean",
        "JK": "last",
        "lr": 0.0001,
        "epochs": 100,
        "patience": 20,
        "min_delta": 0.0
      },
      "chemberta": {
        "max_length": 128,
        "batch_size": 32,
        "lr": 0.0001,
        "epochs": 20,
        "patience": 5,
        "weight_decay": 0.0,
        "warmup_ratio": 0.06,
        "trust_remote_code": true
      },
      "chemprop": {
        "epochs": 100,
        "patience": 20,
        "batch_size": 32,
        "hidden_dim": 300,
        "depth": 3,
        "dropout": 0.0
      }
    }
  },
  "ensemble": {
    "k": 4,
    "n_bootstrap": 2000,
    "dpi": 300
